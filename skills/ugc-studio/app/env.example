# Nothing to set for local runs: with no DATABASE_URL the app uses embedded PGlite (./.data/pglite), and with no
# GRAPHED_STORAGE_* it keeps files in ./.data/storage. Graphed Tools calls need `graphed dev run -- node server.mjs`.
# In Graphed cloud, DATABASE_URL comes from databases.primary and GRAPHED_STORAGE_* from project storage.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# VIDEO_LANES=10   # paid renders at once
# HEAVY_LANES=1    # ffmpeg + word fixer jobs at once (0.5 CPU / 512 MB container)
