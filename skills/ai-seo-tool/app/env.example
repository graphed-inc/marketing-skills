# In Graphed cloud nothing needs to be set: DATABASE_URL comes from databases.primary, and Graphed Tools, the LLM
# proxy and the warehouse come from the runtime.
# Local run with real tools: `graphed dev run --account <act_…> --project <slug> -- node server.mjs`
# Without DATABASE_URL the app uses an embedded Postgres (PGlite) in PGLITE_DIR.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# PGLITE_DIR=./.data/local
# PORT=3000
# NO_WORKER=1        # serve pages and API only; do not run jobs (smoke.mjs uses this)
