# Local Postgres (docker compose up -d). Leave unset to use embedded PGlite instead.
# In Graphed cloud, DATABASE_URL is injected from databases.primary.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# Optional model overrides (Graphed OpenRouter proxy model ids).
# VISION_MODEL=google/gemini-2.5-flash
# WRITER_MODEL=anthropic/claude-sonnet-5.5
