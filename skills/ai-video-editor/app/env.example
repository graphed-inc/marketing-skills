# In Graphed cloud nothing needs to be set: DATABASE_URL comes from databases.primary, GRAPHED_STORAGE_* from
# project storage, and Graphed Tools credentials from the runtime.
# Local run: `graphed dev run --account <act_…> --project <slug> -- node server.mjs` gives storage and Tools;
# add a Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# PUBLIC_URL=http://localhost:3000   # the app's own URL in prompts; in the cloud it is learned from the first page request
# RENDER_SANDBOXES=4                 # Modal sandboxes per render (the account may run 5 at once)
# RENDER_SLOTS=8                     # chunks rendered at the same time in each sandbox
